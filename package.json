{
  "name": "nova-bank",
  "private": true,
  "version": "0.1.0",
  "description": "nova-bank — Persian/Iranian financial super-app",
  "scripts": {
    "build": "pnpm -r --stream run build",
    "dev": "pnpm -r --stream run dev",
    "lint": "pnpm -r --stream run lint",
    "lint:fix": "pnpm -r --stream run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r --stream run typecheck",
    "test": "pnpm -r --stream run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
