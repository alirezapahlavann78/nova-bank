generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BANK
  CASH
  WALLET
  CREDIT
}

enum Currency {
  IRT
  USD
  EUR
}

enum CardType {
  DEBIT
  CREDIT
  PREPAID
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  GOAL_MILESTONE
  GOAL_COMPLETED
  TRANSACTION_CREATED
  TRANSFER_COMPLETED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  PAYMENT_CANCELLED
  SCHEDULED_PAYMENT_FAILED
  SYSTEM
  INVESTMENT_GOAL_MILESTONE
  INVESTMENT_GOAL_COMPLETED
  PORTFOLIO_MOVEMENT
  DIVIDEND_RECEIVED
  UNREALIZED_LOSS
  UNREALIZED_GAIN
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  email     String?  @unique
  password  String?
  firstName String?
  lastName  String?
  locale    String   @default("fa-IR")
  timezone  String   @default("Asia/Tehran")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions               Session[]
  devices                Device[]
  accounts               Account[]
  cards                  Card[]
  categories             Category[]
  transactions           Transaction[]
  recurringTransactions  RecurringTransaction[]
  transfers              Transfer[]
  budgets                Budget[]
  goals                  Goal[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  aiConversations        AIConversation[]
  investmentAccounts     InvestmentAccount[]
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]
  watchlists             Watchlist[]
  watchlistItems         WatchlistItem[]
  beneficiaries          Beneficiary[]
  paymentTemplates       PaymentTemplate[]
  payments               Payment[]
  paymentAudits          PaymentAudit[]
  scheduledPayments      ScheduledPayment[]
  paymentExecutions      PaymentExecution[]

  @@index([phone])
  @@index([email])
}

model Session {
  id              String    @id @default(uuid())
  refreshTokenHash String   @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  device Device?

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id         String   @id @default(uuid())
  deviceId   String   @unique
  platform   String
  name       String?
  pushToken  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?  @unique
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Bank {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameEn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]

  @@index([code])
}

model Account {
  id           String     @id @default(uuid())
  userId       String
  bankId       String?
  name         String
  type         AccountType
  accountNumber String?
  currency     Currency   @default(IRT)
  balance      Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank      Bank?     @relation(fields: [bankId], references: [id])
  cards     Card[]
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  outgoingTransfers Transfer[] @relation("TransferSource")
  incomingTransfers Transfer[] @relation("TransferDestination")

  @@index([userId])
  @@index([userId, bankId])
  @@index([userId, type])
}

model Card {
  id           String     @id @default(uuid())
  userId       String
  accountId    String
  name         String
  last4        String
  cardType     CardType
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, isActive])
}

model Category {
  id        String        @id @default(uuid())
  userId    String?
  name      String
  nameEn    String
  icon      String?
  type      CategoryType
  isSystem  Boolean       @default(false)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user                 User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets              Budget[]

  @@index([userId])
  @@index([type])
  @@index([isSystem])
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  accountId       String
  categoryId      String
  type            TransactionType
  amount          Int
  description     String?
  transactionDate DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account    @relation(fields: [accountId], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@index([userId, type])
  @@index([userId, transactionDate])
}

model Transfer {
  id                  String    @id @default(uuid())
  userId              String
  sourceAccountId     String
  destinationAccountId String
  amount              Int
  currency            Currency @default(IRT)
  description         String?
  transactionDate     DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount     Account  @relation("TransferSource", fields: [sourceAccountId], references: [id])
  destinationAccount Account @relation("TransferDestination", fields: [destinationAccountId], references: [id])

  @@index([userId])
  @@index([userId, sourceAccountId])
  @@index([userId, destinationAccountId])
  @@index([userId, transactionDate])
}

model RecurringTransaction {
  id          String            @id @default(uuid())
  userId      String
  accountId   String
  categoryId  String
  type        TransactionType
  amount      Int
  currency    Currency          @default(IRT)
  description String?
  frequency   RecurringFrequency
  startDate   DateTime
  endDate     DateTime?
  nextRunAt   DateTime
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, nextRunAt])
  @@index([userId, isActive])
}

model Budget {
  id          String      @id @default(uuid())
  userId      String
  categoryId  String?
  name        String
  amount      Int
  currency    Currency    @default(IRT)
  period      BudgetPeriod
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([userId, categoryId])
  @@index([userId, period])
  @@index([userId, isActive])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  description   String?
  targetAmount  Int
  currentAmount Int        @default(0)
  currency      Currency   @default(IRT)
  targetDate    DateTime
  isCompleted   Boolean    @default(false)
  isActive      Boolean    @default(true)
  goalType      GoalType   @default(SAVINGS)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

enum GoalType {
  SAVINGS
  INVESTMENT
}

enum PaymentType {
  BILL_PAYMENT
  TOP_UP
  DOMESTIC_TRANSFER
  MOBILE_TOPUP
  CHARITY
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum PaymentDestinationType {
  ACCOUNT
  CARD
  MOBILE
  BILL
  CHARITY
}

enum ScheduledPaymentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Notification {
  id        String          @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean         @default(false)
  readAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type])
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  budgetAlerts    Boolean  @default(true)
  goalAlerts      Boolean  @default(true)
  transactionAlerts Boolean @default(false)
  transferAlerts  Boolean  @default(false)
  paymentAlerts   Boolean  @default(false)
  systemAlerts    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AIMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum AIAgentExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AIToolExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AIToolConfirmationState {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
}

enum AIToolRiskLevel {
  READ
  ACTION_LOW
  ACTION_HIGH
}

model AIConversation {
  id          String    @id @default(uuid())
  userId      String
  agentId     String
  title       String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]
  executions  AIAgentExecution[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, startedAt])
  @@index([agentId])
}

model AIMessage {
  id              String          @id @default(uuid())
  conversationId  String
  role            AIMessageRole
  content         String?
  toolCalls       Json?
  toolResults     Json?
  tokenUsage      Int?            @default(0)
  createdAt       DateTime        @default(now())

  conversation    AIConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model AIAgentExecution {
  id              String                @id @default(uuid())
  conversationId  String
  agentId         String
  model           String
  status          AIAgentExecutionStatus @default(RUNNING)
  startedAt       DateTime              @default(now())
  endedAt         DateTime?
  durationMs      Int?
  inputTokens     Int?                  @default(0)
  outputTokens    Int?                  @default(0)
  error           String?

  conversation    AIConversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolExecutions  AIToolExecution[]

  @@index([conversationId])
  @@index([agentId])
  @@index([status])
}

model AIToolExecution {
  id              String              @id @default(uuid())
  executionId     String
  toolName        String
  riskLevel       AIToolRiskLevel
  status          AIToolExecutionStatus @default(PENDING)
  input           Json?
  output          Json?
  durationMs      Int?
  confirmationState AIToolConfirmationState @default(PENDING_CONFIRMATION)
  createdAt       DateTime            @default(now())
  confirmedAt     DateTime?

  execution       AIAgentExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([toolName])
  @@index([confirmationState])
}

enum InvestmentAccountType {
  BROKERAGE
  RETIREMENT
  SAVINGS_INVESTMENT
  OTHER
}

enum InvestmentAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AssetType {
  STOCK
  ETF
  BOND
  MUTUAL_FUND
  CRYPTO
  CASH
  OTHER
}

enum InvestmentTransactionType {
  BUY
  SELL
  DIVIDEND
  DEPOSIT
  WITHDRAWAL
  FEE
  INTEREST
  OTHER
}

model InvestmentAccount {
  id            String                  @id @default(uuid())
  userId        String
  accountNumber String?
  brokerName    String?
  accountType   InvestmentAccountType   @default(BROKERAGE)
  baseCurrency  Currency                @default(USD)
  cashBalance   Float                   @default(0)
  totalValue    Float                   @default(0)
  status        InvestmentAccountStatus @default(ACTIVE)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings           Holding[]
  transactions       InvestmentTransaction[]
  watchlistItems     WatchlistItem[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, accountType])
}

model Asset {
  id            String     @id @default(uuid())
  symbol        String
  name          String
  assetType     AssetType
  exchange      String?
  currency      Currency
  isin          String?    @unique
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  holdings            Holding[]
  investmentTransactions InvestmentTransaction[]
  watchlistItems      WatchlistItem[]

  @@index([symbol])
  @@index([assetType])
  @@index([isActive])
  @@unique([symbol, exchange])
}

model Holding {
  id              String   @id @default(uuid())
  userId          String
  accountId       String
  assetId         String
  quantity        Float
  averageCost     Float
  totalCost        Float
  currentValue    Float
  unrealizedPL     Float
  unrealizedPLPercentage Float
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     InvestmentAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset       Asset                   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, assetId])
  @@index([userId, accountId, assetId])
  @@unique([userId, accountId, assetId])
}

model InvestmentTransaction {
  id              String                   @id @default(uuid())
  userId          String
  accountId       String
  assetId         String?
  transactionType InvestmentTransactionType
  quantity        Float?
  price           Float?
  amount          Float
  fees            Float                    @default(0)
  currency        Currency                 @default(USD)
  transactionDate DateTime
  reference       String?
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   InvestmentAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset     Asset?             @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, transactionDate])
  @@index([userId, transactionType])
}

model Watchlist {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WatchlistItem[]

  @@index([userId])
  @@index([userId, isDefault])
  @@unique([userId, name])
}

model WatchlistItem {
  id          String   @id @default(uuid())
  userId      String
  watchlistId String
  assetId     String
  accountId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist   Watchlist         @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  account     InvestmentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, watchlistId])
  @@index([userId, assetId])
  @@unique([userId, watchlistId, assetId])
}

model Beneficiary {
  id               String                @id @default(uuid())
  userId           String
  name             String
  destinationType  PaymentDestinationType
  destinationValue String
  bankCode         String?
  bankName         String?
  isFavorite       Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentTemplates PaymentTemplate[]

  @@index([userId])
  @@index([userId, destinationType])
  @@unique([userId, destinationValue, destinationType])
}

model PaymentTemplate {
  id              String                @id @default(uuid())
  userId          String
  name            String
  type            PaymentType
  amount          Int?
  sourceAccountId String?
  destinationType PaymentDestinationType
  destinationValue String
  beneficiaryId    String?
  description     String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiary  Beneficiary?  @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  scheduledPayments ScheduledPayment[]

  @@index([userId])
  @@index([userId, isActive])
}

model Payment {
  id                  String           @id @default(uuid())
  userId              String
  type                PaymentType
  status              PaymentStatus    @default(PENDING)
  amount              Int
  currency            Currency         @default(IRT)
  sourceAccountId     String
  destinationType     PaymentDestinationType
  destinationValue    String
  destinationName     String?
  description         String?
  fees                Int              @default(0)
  reference           String?
  internalReference   String?          @unique
  riskLevel           String?          @default("LOW")
  executedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions  PaymentExecution[]
  audits      PaymentAudit[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([internalReference])
}

model ScheduledPayment {
  id              String               @id @default(uuid())
  userId          String
  templateId      String?
  type            PaymentType
  amount          Int
  currency        Currency             @default(IRT)
  sourceAccountId String
  destinationType PaymentDestinationType
  destinationValue String
  status          ScheduledPaymentStatus @default(ACTIVE)
  frequency       RecurringFrequency
  startDate       DateTime
  endDate         DateTime?
  nextRunAt       DateTime
  lastRunAt       DateTime?
  runCount        Int                  @default(0)
  maxRuns         Int?
  description     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     PaymentTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  executions   PaymentExecution[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, nextRunAt])
}

model PaymentExecution {
  id                  String           @id @default(uuid())
  userId              String
  paymentId           String?
  scheduledPaymentId  String?
  status              ExecutionStatus  @default(PENDING)
  attemptNumber       Int              @default(1)
  errorCode           String?
  errorMessage        String?
  externalReference   String?
  processedAt         DateTime?
  createdAt           DateTime         @default(now())

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment            Payment?          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  scheduledPayment   ScheduledPayment? @relation(fields: [scheduledPaymentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentId])
  @@index([scheduledPaymentId])
  @@index([status])
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @unique
  userId       String
  resourceType String
  resourceId   String?
  requestHash  String?
  status       String   @default("PENDING")
  response     Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([key])
  @@index([userId])
  @@index([expiresAt])
}

model PaymentAudit {
  id              String    @id @default(uuid())
  paymentId       String
  userId          String
  action          String
  status          String
  requestId       String?
  failureReason   String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([userId])
  @@index([userId, createdAt])
}