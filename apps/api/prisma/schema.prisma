generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BANK
  CASH
  WALLET
  CREDIT
}

enum Currency {
  IRT
  USD
  EUR
}

enum CardType {
  DEBIT
  CREDIT
  PREPAID
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  GOAL_MILESTONE
  GOAL_COMPLETED
  TRANSACTION_CREATED
  TRANSFER_COMPLETED
  SYSTEM
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  email     String?  @unique
  password  String?
  firstName String?
  lastName  String?
  locale    String   @default("fa-IR")
  timezone  String   @default("Asia/Tehran")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions               Session[]
  devices                Device[]
  accounts               Account[]
  cards                  Card[]
  categories             Category[]
  transactions           Transaction[]
  recurringTransactions  RecurringTransaction[]
  transfers              Transfer[]
  budgets                Budget[]
  goals                  Goal[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@index([phone])
  @@index([email])
}

model Session {
  id              String    @id @default(uuid())
  refreshTokenHash String   @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  device Device?

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id         String   @id @default(uuid())
  deviceId   String   @unique
  platform   String
  name       String?
  pushToken  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?  @unique
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Bank {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameEn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]

  @@index([code])
}

model Account {
  id           String     @id @default(uuid())
  userId       String
  bankId       String?
  name         String
  type         AccountType
  accountNumber String?
  currency     Currency   @default(IRT)
  balance      Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank      Bank?     @relation(fields: [bankId], references: [id])
  cards     Card[]
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  outgoingTransfers Transfer[] @relation("TransferSource")
  incomingTransfers Transfer[] @relation("TransferDestination")

  @@index([userId])
  @@index([userId, bankId])
  @@index([userId, type])
}

model Card {
  id           String     @id @default(uuid())
  userId       String
  accountId    String
  name         String
  last4        String
  cardType     CardType
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, isActive])
}

model Category {
  id        String        @id @default(uuid())
  userId    String?
  name      String
  nameEn    String
  icon      String?
  type      CategoryType
  isSystem  Boolean       @default(false)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user                 User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets              Budget[]

  @@index([userId])
  @@index([type])
  @@index([isSystem])
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  accountId       String
  categoryId      String
  type            TransactionType
  amount          Int
  description     String?
  transactionDate DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account    @relation(fields: [accountId], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@index([userId, type])
  @@index([userId, transactionDate])
}

model Transfer {
  id                  String    @id @default(uuid())
  userId              String
  sourceAccountId     String
  destinationAccountId String
  amount              Int
  currency            Currency @default(IRT)
  description         String?
  transactionDate     DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount     Account  @relation("TransferSource", fields: [sourceAccountId], references: [id])
  destinationAccount Account @relation("TransferDestination", fields: [destinationAccountId], references: [id])

  @@index([userId])
  @@index([userId, sourceAccountId])
  @@index([userId, destinationAccountId])
  @@index([userId, transactionDate])
}

model RecurringTransaction {
  id          String            @id @default(uuid())
  userId      String
  accountId   String
  categoryId  String
  type        TransactionType
  amount      Int
  currency    Currency          @default(IRT)
  description String?
  frequency   RecurringFrequency
  startDate   DateTime
  endDate     DateTime?
  nextRunAt   DateTime
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, nextRunAt])
  @@index([userId, isActive])
}

model Budget {
  id          String      @id @default(uuid())
  userId      String
  categoryId  String?
  name        String
  amount      Int
  currency    Currency    @default(IRT)
  period      BudgetPeriod
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([userId, categoryId])
  @@index([userId, period])
  @@index([userId, isActive])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  description   String?
  targetAmount  Int
  currentAmount Int        @default(0)
  currency      Currency   @default(IRT)
  targetDate    DateTime
  isCompleted   Boolean    @default(false)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

model Notification {
  id        String          @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean         @default(false)
  readAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type])
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  budgetAlerts    Boolean  @default(true)
  goalAlerts      Boolean  @default(true)
  transactionAlerts Boolean @default(false)
  transferAlerts  Boolean  @default(false)
  systemAlerts    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}