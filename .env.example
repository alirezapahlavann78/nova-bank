# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL="postgresql://nova:nova@localhost:5432/nova_bank?schema=public"

# Authentication
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=change-me-in-production
REFRESH_TOKEN_EXPIRY=7d

# AI
AI_GATEWAY_ENABLED=false
AI_PROVIDER_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096

# Subscription
SUBSCRIPTION_WEBHOOK_SECRET=

# Iranian Localization
DEFAULT_CURRENCY=toman
DEFAULT_LOCALE=fa-IR

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Monitoring
SENTRY_DSN=
