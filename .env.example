# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL="postgresql://nova:nova@localhost:5432/nova_bank?schema=public"

# Authentication
JWT_SECRET=change-me-in-production-32-chars-minimum
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-in-production-32-chars-minimum
REFRESH_TOKEN_EXPIRES_IN=30d

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Iranian Localization
DEFAULT_CURRENCY=toman
DEFAULT_LOCALE=fa-IR

# Monitoring
SENTRY_DSN=
